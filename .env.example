# Kronode Configuration
# All optional — works with zero env vars in local mode.
# Copy to .env and customize as needed.

# ── LLM Keys (BYOK mode) ─────────────────────────────────────────────────────
# Set any of these for richer LLM-based convention extraction from PR diffs.
# Without them, Kronode extracts from reviewer comments only (free, no LLM).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ── Ingestion Settings ────────────────────────────────────────────────────────
# Number of merged PRs to analyze for convention extraction (default: 200)
KRONODE_PR_COUNT=200

# Minimum convention confidence to include in results (0.0 - 1.0, default: 0.5)
KRONODE_MIN_CONFIDENCE=0.5

# Maximum conventions returned per query (default: 20)
KRONODE_MAX_CONVENTIONS=20

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite at ~/.kronode/kronode.db (zero config)
# Uncomment for PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kronode

# ── MCP Server ────────────────────────────────────────────────────────────────
# Default: stdio (for Claude Code, Codex)
# Set to "http" for Cursor, Copilot, remote access
# KRONODE_TRANSPORT=stdio
# KRONODE_PORT=8001
