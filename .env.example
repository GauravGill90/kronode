# ── Clerk ──────────────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ── Database (Supabase PostgreSQL) ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kronode

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ───────────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Sentry error tracking (optional but recommended for production)
SENTRY_DSN=

# ── LLM Providers ─────────────────────────────────────────────────────────────
# LLM — Quality (required: planner, coder, reviewer)
ANTHROPIC_API_KEY=sk-ant-...

# LLM — Cheap (auto-failover: Gemini → DeepSeek → OpenAI → Haiku)
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# ── GitHub ─────────────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub App (for PR comments integration)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# ── Jira ───────────────────────────────────────────────────────────────────────
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# ��─ Slack ──────────────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ── Backend ────────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ── Dev / testing ──────────────────────────────────────────────────────────────
BYPASS_LLM=false
BYPASS_AUTH=false
BYPASS_AUTH_USER_ID=

# ── Pipeline step flags (in execution order) ───────────────────────────────────
SKIP_TICKET_INTERPRETER=false
SKIP_CONTEXT_BUILDER=false
SKIP_CLARIFICATION=false
SKIP_PLANNER=false
SKIP_PLAN_POSTING=false
SKIP_GUARDRAILS=false
SKIP_CODER=false
SKIP_TESTER=false
SKIP_EXECUTION_VERIFIER=false
SKIP_REVIEWER=false
SKIP_MEMORY=false

# ── Beat schedule flags ────────────────────────────────────────────────────────
ENABLE_POLL_PR=true
ENABLE_POLL_CLARIFICATION=true
ENABLE_CONVENTION_REFRESH=false

# ── Frontend (Next.js) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
