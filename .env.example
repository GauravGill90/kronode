# ── Clerk ──────────────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ── Database (Supabase PostgreSQL) ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kronode

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM Providers ─────────────────────────────────────────────────────────────
# LLM — Quality (required: planner, coder, reviewer)
ANTHROPIC_API_KEY=sk-ant-...

# LLM — Cheap (auto-failover: Gemini → DeepSeek → OpenAI → Haiku)
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# ── GitHub ─────────────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Jira ───────────────────────────────────────────────────────────────────────
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# ── Slack ──────────────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ── Backend ────────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ── Dev / testing ──────────────────────────────────────────────────────────────
BYPASS_LLM=false
BYPASS_AUTH=false
BYPASS_AUTH_USER_ID=

# ── Pipeline step flags (in execution order) ───────────────────────────────────
SKIP_TICKET_INTERPRETER=false
SKIP_CONTEXT_BUILDER=false
SKIP_CLARIFICATION=false
SKIP_PLANNER=false
SKIP_PLAN_POSTING=false
SKIP_GUARDRAILS=false
SKIP_CODER=false
SKIP_TESTER=false
SKIP_EXECUTION_VERIFIER=false
SKIP_REVIEWER=false
SKIP_MEMORY=false

# ── Frontend (Next.js) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
