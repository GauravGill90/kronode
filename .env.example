# Kronode — all optional. Works with zero env vars in local mode.

# ── BYOK Mode (optional) ──────────────────────────────────────────────────────
# Set any LLM API key for richer convention extraction from PR diffs.
# Without them, Kronode uses local embeddings + reviewer comment extraction.
# Supports: OpenAI, Anthropic, Gemini, DeepSeek (auto-detects from key)
LLM_API_KEY=

# ── Database (optional) ───────────────────────────────────────────────────────
# Default: SQLite at ~/.kronode/kronode.db (zero config)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kronode
